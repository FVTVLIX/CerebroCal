# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude tooling
.claude/

# Env secrets
.env.local
.env.*.local

# Brainstorm mockups
.superpowers/

# Google service account key (if accidentally downloaded here)
*.json
!package.json
!package-lock.json
!tsconfig.json
!jest.config.ts
